###############################################################################
# mailgate configuration. Copy to .env and edit. All vars start MAILGATE_.
###############################################################################

# --- SMTP server (required) -------------------------------------------------
MAILGATE_SMTP_HOST=smtp-relay.brevo.com
MAILGATE_SMTP_PORT=587
MAILGATE_SMTP_USER=your-brevo-smtp-login@example.com
MAILGATE_SMTP_PASSWORD=your-brevo-smtp-key
MAILGATE_SMTP_USE_TLS=true
MAILGATE_SMTP_TIMEOUT=15

# --- HTTP server ------------------------------------------------------------
MAILGATE_HOST=0.0.0.0
MAILGATE_PORT=8080
MAILGATE_LOG_LEVEL=INFO

###############################################################################
# Single-tenant client config (use this when deploying for one site).
# For multi-tenant, set MAILGATE_CLIENTS_FILE to a JSON file path instead.
###############################################################################

MAILGATE_CLIENT_NAME=antikas
# Generate with: python -c "import secrets; print('mg_'+secrets.token_urlsafe(24))"
MAILGATE_CLIENT_API_KEY=mg_REPLACE_WITH_RANDOM_TOKEN

# --- Defaults (used when caller omits these in JSON body / form fields) ---
# When the caller doesn't send "from", this is used.
MAILGATE_CLIENT_DEFAULT_FROM=Antikas Formular <forms@forms.antikas.de>
# When the caller doesn't send "to", this is used. Comma-separated.
MAILGATE_CLIENT_DEFAULT_TO=info@antikas.de
# Prepended to every subject. Useful for inbox filtering.
MAILGATE_CLIENT_SUBJECT_PREFIX=[Antikas]

# --- Lockdown (the security boundary, comma-separated) ---------------------
# Browser CORS check. Strongly recommended.
MAILGATE_CLIENT_ALLOWED_ORIGINS=https://www.antikas.de,https://antikas.de,http://localhost:4321

# Restricts the From: header. Prevents impersonation across senders.
MAILGATE_CLIENT_ALLOWED_FROM_ADDRESSES=forms@forms.antikas.de

# Restricts the recipient list. **Most important field for public keys.**
# Empty = anyone can be the recipient (DO NOT use with public keys).
MAILGATE_CLIENT_ALLOWED_TO_ADDRESSES=info@antikas.de

# --- Rate limiting (defaults shown) ----------------------------------------
MAILGATE_CLIENT_RATE_LIMIT_PER_MINUTE=10
# Per-IP minute throttle. Useful when api_key is exposed in browser code.
MAILGATE_CLIENT_RATE_LIMIT_PER_MINUTE_PER_IP=2
# Per-key daily cap (omit for no daily cap).
MAILGATE_CLIENT_DAILY_LIMIT=200
# Per-IP daily cap (omit for no per-IP daily cap).
MAILGATE_CLIENT_DAILY_LIMIT_PER_IP=5

# --- Optional extras --------------------------------------------------------
# Comma-separated IPs / CIDR ranges to hard-reject (e.g. known abusers).
MAILGATE_CLIENT_IP_BLOCKLIST=

# Captcha (one provider per client). Provider: turnstile | hcaptcha | recaptcha.
# JSON-mode requests include header: X-Captcha-Token: <token>
# Form-mode requests include the provider's standard field
#   (cf-turnstile-response / h-captcha-response / g-recaptcha-response)
MAILGATE_CLIENT_CAPTCHA_PROVIDER=
MAILGATE_CLIENT_CAPTCHA_SECRET=

# Legacy (still works, equivalent to CAPTCHA_PROVIDER=turnstile + CAPTCHA_SECRET=...)
# MAILGATE_CLIENT_TURNSTILE_SECRET=

###############################################################################
# Multi-tenant alternative (JSON file). Leave empty for single-tenant env mode.
###############################################################################
# MAILGATE_CLIENTS_FILE=/app/clients.json
